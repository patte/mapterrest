# Copy to .env.deploy (gitignored) and fill in.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Purge-all of the CDN cache after the sync. Account API key (dashboard → Account →
# API Key) and the pull zone's numeric id. Optional: missing values skip the purge
# with a warning.
BUNNY_API_KEY=
BUNNY_PULLZONE_ID=
# Source-map upload to Bugsink (Bugsink UI → Tokens). Optional: missing value
# skips the upload with a warning, and events stay minified.
SENTRY_AUTH_TOKEN=
