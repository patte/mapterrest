{
  "name": "mapterrest",
  "version": "1.0.0",
  "description": "Mapterhorn terrain tiles in MapLibre 3D",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "probe:coverage": "node scripts/probe-coverage.mjs",
    "bake:thumbs": "node scripts/bake-thumbs.mjs",
    "browser:start": "node scripts/browser-daemon.mjs start",
    "browser:stop": "node scripts/browser-daemon.mjs stop",
    "test": "playwright test",
    "verify": "playwright test",
    "deploy": "bash scripts/deploy.sh"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sentry/cli": "^3.6.2",
    "@types/node": "^26.2.0",
    "marked": "^18.0.10",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@sentry/browser": "^10.70.0",
    "maplibre-contour": "0.1.0",
    "maplibre-gl": "6.5.0"
  }
}
